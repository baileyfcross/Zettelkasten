{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Rigid Body Fracture and Collision.md::0","sourceKey":"6 - Full Notes/Rigid Body Fracture and Collision.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"rigid body fracture and collision rigid body fracture and collision","filePath":"6 - Full Notes/Rigid Body Fracture and Collision.md","fileName":"Rigid Body Fracture and Collision.md","folder":"6 - Full Notes","title":"Rigid Body Fracture and Collision","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-15 18:17\n\nStatus: #baby\n\nTags: [[Particle and Destruction VFX]]","tags":["baby"],"links":["Particle and Destruction VFX","Choreographing Destruction Layers","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Rigid Body Fracture and Collision.md::1","sourceKey":"6 - Full Notes/Rigid Body Fracture and Collision.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"rigid body fracture and collision rigid body fracture and collision","filePath":"6 - Full Notes/Rigid Body Fracture and Collision.md","fileName":"Rigid Body Fracture and Collision.md","folder":"6 - Full Notes","title":"Rigid Body Fracture and Collision","heading":"Rigid Body Fracture and Collision","sectionNumber":"","sectionTitle":"","content":"A rigid-body solver moves hard pieces that retain their shapes while colliding under specified forces. To destroy a solid-looking building in the book's example, the model is first fractured into separate parts, then a non-rendering collision object is driven into it. The solver sends the fragments apart, but their visual suitability still depends on the fracture design, materials, timing, and motion blur. A full intact model can be shown until the moment it is swapped for the fractured version. See [[Choreographing Destruction Layers]].","tags":["baby"],"links":["Particle and Destruction VFX","Choreographing Destruction Layers","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Rigid Body Fracture and Collision.md::2","sourceKey":"6 - Full Notes/Rigid Body Fracture and Collision.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"rigid body fracture and collision rigid body fracture and collision","filePath":"6 - Full Notes/Rigid Body Fracture and Collision.md","fileName":"Rigid Body Fracture and Collision.md","folder":"6 - Full Notes","title":"Rigid Body Fracture and Collision","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[digitalvisualeffectsandcompositing.pdf]]","tags":["baby"],"links":["Particle and Destruction VFX","Choreographing Destruction Layers","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}