edesignvocabulary.pdf]]"],[6908,"[[agamedesignvocabulary.pdf]]"],[6911,"[[agamedesignvocabulary.pdf]]"],[7064,"[[agamedesignvocabulary.pdf]]"],[7484,"[[agamedesignvocabulary.pdf]]"],[7490,"[[agamedesignvocabulary.pdf]]"],[7601,"[[agamedesignvocabulary.pdf]]"],[7781,"[[agamedesignvocabulary.pdf]]"],[8899,"[[agamedesignvocabulary.pdf]]"],[9787,"[[agamedesignvocabulary.pdf]]"],[10012,"[[agamedesignvocabulary.pdf]]"],[11029,"[[agamedesignvocabulary.pdf]]"],[11584,"[[agamedesignvocabulary.pdf]]"],[11602,"[[agamedesignvocabulary.pdf]]"],[11653,"[[agamedesignvocabulary.pdf]]"],[11659,"[[agamedesignvocabulary.pdf]]"],[11662,"[[agamedesignvocabulary.pdf]]"],[11716,"[[agamedesignvocabulary.pdf]]"],[11728,"[[agamedesignvocabulary.pdf]]"],[11794,"[[agamedesignvocabulary.pdf]]"],[11836,"[[agamedesignvocabulary.pdf]]"],[11851,"[[agamedesignvocabulary.pdf]]"],[11878,"[[agamedesignvocabulary.pdf]]"],[12064,"[[agamedesignvocabulary.pdf]]"],[12763,"[[agamedesignvocabulary.pdf]]"],[12802,"[[agamedesignvocabulary.pdf]]"],[12835,"[[agamedesignvocabulary.pdf]]"],[13234,"[[agamedesignvocabulary.pdf]]"],[13249,"[[agamedesignvocabulary.pdf]]"],[13633,"[[agamedesignvocabulary.pdf]]"],[13966,"[[agamedesignvocabulary.pdf]]"],[14326,"[[agamedesignvocabulary.pdf]]"],[14773,"[[agamedesignvocabulary.pdf]]"],[15679,"[[agamedesignvocabulary.pdf]]"],[17032,"[[agamedesignvocabulary.pdf]]"],[17059,"[[agamedesignvocabulary.pdf]]"],[17578,"[[agamedesignvocabulary.pdf]]"],[17647,"[[agamedesignvocabulary.pdf]]"],[19249,"[[agamedesignvocabulary.pdf]]"],[19327,"[[agamedesignvocabulary.pdf]]"],[20272,"[[agamedesignvocabulary.pdf]]"],[11857,"[[agamedesignvocabulary.pdf]]\n\n[[fundamentalsofgamedesign3e.pdf]]"],[13528,"[[agamedesignvocabulary.pdf]]\n\n[[fundamentalsofgamedesign3e.pdf]]"],[11671,"[[agamedesignvocabulary.pdf]]\n[[gamesdesignandplay.pdf]]"],[21067,"[[Agile Engineering and Quality]] treats quality as a continuous property of development rather than a final phase. Automated tests, asset validation, continuous integration, embedded quality assurance, smoke tests, and frequent playable builds shorten the distance between introducing a defect and learning about it. Practices such as pair programming and test-driven development also spread knowledge while making assumptions executable.\n\nThis approach changes the meaning of “done.” A feature is not complete merely because its primary implementation exists. It must be integrated, testable, usable in the current build, and consistent with the shared definition of quality. A hardening period may still be useful for release preparation, but it should not become the first time the parts are assembled."],[21069,"[[Agile Team Leadership]] focuses on the conditions under which a team can solve problems rather than on directing every solution. Coaching, facilitation, active listening, psychological safety, and shared accountability allow information to surface early. Leadership changes with the situation: a newly formed or blocked team may need more structure, while an experienced team benefits from autonomy and a clear outcome.\n\nHealthy disagreement is part of creative production. Participatory decision making helps teams explore divergent possibilities before converging on a commitment. Retrospectives and root-cause analysis turn failures into changes in the system rather than occasions for blame. This learning capacity is essential because a game cannot be fully specified before people play it."],[249,"[[agilegamedevelopment2e.pdf]]"],[255,"[[agilegamedevelopment2e.pdf]]"],[264,"[[agilegamedevelopment2e.pdf]]"],[318,"[[agilegamedevelopment2e.pdf]]"],[714,"[[agilegamedevelopment2e.pdf]]"],[834,"[[agilegamedevelopment2e.pdf]]"],[912,"[[agilegamedevelopment2e.pdf]]"],[1236,"[[agilegamedevelopment2e.pdf]]"],[1491,"[[agilegamedevelopment2e.pdf]]"],[1557,"[[agilegamedevelopment2e.pdf]]"],[1647,"[[agilegamedevelopment2e.pdf]]"],[1932,"[[agilegamedevelopment2e.pdf]]"],[2043,"[[agilegamedevelopment2e.pdf]]"],[2046,"[[agilegam