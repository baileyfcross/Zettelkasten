{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Blender DNA RNA Mapping.md::0","sourceKey":"6 - Full Notes/Blender DNA RNA Mapping.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender dna rna mapping blender dna rna mapping","filePath":"6 - Full Notes/Blender DNA RNA Mapping.md","fileName":"Blender DNA RNA Mapping.md","folder":"6 - Full Notes","title":"Blender DNA RNA Mapping","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-14 00:20\n\nStatus: #baby\n\nTags: [[Blender RNA Data Architecture]]","tags":["baby"],"links":["Blender RNA Data Architecture","Blender PointerRNA","Blender RNA Access API","Blender DNA System","Blender StructRNA","Blender PropertyRNA","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender DNA RNA Mapping.md::1","sourceKey":"6 - Full Notes/Blender DNA RNA Mapping.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender dna rna mapping blender dna rna mapping","filePath":"6 - Full Notes/Blender DNA RNA Mapping.md","fileName":"Blender DNA RNA Mapping.md","folder":"6 - Full Notes","title":"Blender DNA RNA Mapping","heading":"Blender DNA RNA Mapping","sectionNumber":"","sectionTitle":"","content":"Blender RNA maps descriptive structure and property records onto the fields of persistent DNA structures. A generated getter can cast the data held by [[Blender PointerRNA]], read a specific DNA field, and return it through the typed [[Blender RNA Access API]]; a setter performs the reverse assignment.\n\nThis mapping separates storage from exposure. The [[Blender DNA System]] remains optimized for application state and serialization, while [[Blender StructRNA]] and [[Blender PropertyRNA]] add names, ranges, inheritance, interface text, and callbacks needed by tools and scripting.","tags":["baby"],"links":["Blender RNA Data Architecture","Blender PointerRNA","Blender RNA Access API","Blender DNA System","Blender StructRNA","Blender PropertyRNA","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender DNA RNA Mapping.md::2","sourceKey":"6 - Full Notes/Blender DNA RNA Mapping.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender dna rna mapping blender dna rna mapping","filePath":"6 - Full Notes/Blender DNA RNA Mapping.md","fileName":"Blender DNA RNA Mapping.md","folder":"6 - Full Notes","title":"Blender DNA RNA Mapping","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[coreblenderdevelopment.pdf]]","tags":["baby"],"links":["Blender RNA Data Architecture","Blender PointerRNA","Blender RNA Access API","Blender DNA System","Blender StructRNA","Blender PropertyRNA","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}