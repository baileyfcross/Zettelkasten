{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Inertial Navigation Drift.md::0","sourceKey":"6 - Full Notes/Inertial Navigation Drift.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"inertial navigation drift inertial navigation drift","filePath":"6 - Full Notes/Inertial Navigation Drift.md","fileName":"Inertial Navigation Drift.md","folder":"6 - Full Notes","title":"Inertial Navigation Drift","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-21 00:56\n\nStatus: #baby\n\nTags: [[Pre-Satellite Navigation Systems]]","tags":["baby"],"links":["Pre-Satellite Navigation Systems","gps.epub"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Inertial Navigation Drift.md::1","sourceKey":"6 - Full Notes/Inertial Navigation Drift.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"inertial navigation drift inertial navigation drift","filePath":"6 - Full Notes/Inertial Navigation Drift.md","fileName":"Inertial Navigation Drift.md","folder":"6 - Full Notes","title":"Inertial Navigation Drift","heading":"Inertial Navigation Drift","sectionNumber":"","sectionTitle":"","content":"Inertial navigation derives velocity and position by integrating measurements from gyroscopes and accelerometers. Small sensor biases and alignment errors are integrated along with real motion, so the estimated state gradually diverges from the true state. The system is self-contained, passive, and immune to radio jamming, but it periodically needs an external position fix unless its mission is short. Satellite measurements and inertial estimates therefore complement one another: one supplies absolute correction and the other continuity.","tags":["baby"],"links":["Pre-Satellite Navigation Systems","gps.epub"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Inertial Navigation Drift.md::2","sourceKey":"6 - Full Notes/Inertial Nav