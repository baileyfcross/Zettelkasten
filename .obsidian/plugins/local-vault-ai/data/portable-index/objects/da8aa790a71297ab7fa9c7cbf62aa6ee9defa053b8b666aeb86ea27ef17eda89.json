{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Physical Ergonomics.md::0","sourceKey":"6 - Full Notes/Physical Ergonomics.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"physical ergonomics physical ergonomics","filePath":"6 - Full Notes/Physical Ergonomics.md","fileName":"Physical Ergonomics.md","folder":"6 - Full Notes","title":"Physical Ergonomics","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-05 13:11\n\nStatus: #baby\n\nTags: [[Human-Computer Interaction Foundations]]","tags":["baby"],"links":["Human-Computer Interaction Foundations","Human Factors","Usability","3duserinterfaces2ande.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Physical Ergonomics.md::1","sourceKey":"6 - Full Notes/Physical Ergonomics.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"physical ergonomics physical ergonomics","filePath":"6 - Full Notes/Physical Ergonomics.md","fileName":"Physical Ergonomics.md","folder":"6 - Full Notes","title":"Physical Ergonomics","heading":"Physical Ergonomics","sectionNumber":"","sectionTitle":"","content":"Physical ergonomics concerns how the human musculoskeletal system affects safe, comfortable, and effective interaction. Relevant factors include posture, reach, grip, device weight and balance, muscle groups, movement range, repetition, and how long a pose must be held.\n\nAn interaction can be accurate in a short test yet become tiring or painful during realistic use. A device should therefore be evaluated with representative tasks, grips, poses, and durations. In handheld systems, balance and control placement may matter as much as total weight.\n\nPhysical ergonomics is a major part of [[Human Factors]] and contributes directly to [[Usability]].","tags":["baby"],"links":["Human-Computer Interaction Foundations","Human Factors","Usability","3duserinterfaces2ande.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Physical Ergonomics.md::2","sourceKey":"6 - Full Notes/Physical Ergonomics.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"physical ergonomics physical ergonomics","filePath":"6 - Full Notes/Physical Ergonomics.md","fileName":"Physical Ergonomics.md","folder":"6 - Full Notes","title":"Physical Ergonomics","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[3duserinterfaces2ande.pdf]]","tags":["baby"],"links":["Human-Computer Interaction Foundations","Human Factors","Usability","3duserinterfaces2ande.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}