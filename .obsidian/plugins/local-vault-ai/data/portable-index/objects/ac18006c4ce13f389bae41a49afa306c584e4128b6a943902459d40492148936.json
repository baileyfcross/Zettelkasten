{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Ubiquitous Language.md::0","sourceKey":"6 - Full Notes/Ubiquitous Language.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"ubiquitous language ubiquitous language","filePath":"6 - Full Notes/Ubiquitous Language.md","fileName":"Ubiquitous Language.md","folder":"6 - Full Notes","title":"Ubiquitous Language","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-22 20:53\n\nStatus: #baby\n\nTags: [[Domain Discovery and Ubiquitous Language]]","tags":["baby"],"links":["Domain Discovery and Ubiquitous Language","Context-Specific Language","Linguistic Boundary","hands-ondomain-drivendesignwithnetcore.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Ubiquitous Language.md::1","sourceKey":"6 - Full Notes/Ubiquitous Language.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"ubiquitous language ubiquitous language","filePath":"6 - Full Notes/Ubiquitous Language.md","fileName":"Ubiquitous Language.md","folder":"6 - Full Notes","title":"Ubiquitous Language","heading":"Ubiquitous Language","sectionNumber":"","sectionTitle":"","content":"A Ubiquitous Language is the precise language shared by domain experts and developers within one context. Its terms and behaviors appear consistently in discussions, models, code, tests, interfaces, and data structures. Ubiquitous does not mean one vocabulary for an entire organization; it means the same vocabulary is used vertically through every artifact inside its boundary. When a word develops incompatible meanings, [[Context-Specific Language]] indicates that the model may be crossing a [[Linguistic Boundary]].","tags":["baby"],"links":["Domain Discovery and Ubiquitous Language","Context-Specific Language","Linguistic Boundary","hands-ondomain-drivendesignwithnetcore.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Ubiquitous Language.md::2","sourceKey":"6 - Full Notes/Ubiquitous Language.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"ubiquitous language ubiquitous language","filePath":"6 - Full Notes/Ubiquitous Language.md","fileName":"Ubiquitous Language.md","folder":"6 - Full Notes","title":"Ubiquitous Language","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[hands-ondomain-drivendesignwithnetcore.pdf]]","tags":["baby"],"links":["Domain Discovery and Ubiquitous Language","Context-Specific Language","Linguistic Boundary","hands-ondomain-drivendesignwithnetcore.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}