{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Blender Fluid Simulation.md::0","sourceKey":"6 - Full Notes/Blender Fluid Simulation.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender fluid simulation blender fluid simulation","filePath":"6 - Full Notes/Blender Fluid Simulation.md","fileName":"Blender Fluid Simulation.md","folder":"6 - Full Notes","title":"Blender Fluid Simulation","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-07 23:25\n\nStatus: #baby\n\nTags: [[Blender Simulation and Grease Pencil]]","tags":["baby"],"links":["Blender Simulation and Grease Pencil","Fluid Simulation of Splashes and Fire","blenderfordummies4thedition.pdf","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Fluid Simulation.md::1","sourceKey":"6 - Full Notes/Blender Fluid Simulation.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender fluid simulation blender fluid simulation","filePath":"6 - Full Notes/Blender Fluid Simulation.md","fileName":"Blender Fluid Simulation.md","folder":"6 - Full Notes","title":"Blender Fluid Simulation","heading":"Blender Fluid Simulation","sectionNumber":"","sectionTitle":"","content":"Blender's fluid simulator calculates liquid behavior inside a defined domain. Flow objects introduce fluid, while obstacles and other settings shape how it moves through the simulated space.\n\nThe calculation produces substantial cached data and can generate a changing surface mesh for rendering. Domain resolution trades simulation detail against computation time and storage.\n\nGress's liquid example shows why the interaction solve is important: a moving collider creates wake, foam, splash, and ripples before the result is surfaced as a mesh. His gas example uses fuel and temperature to distinguish smoke from ignition. See [[Fluid Simulation of Splashes and Fire]].","tags":["baby"],"links":["Blender Simulation and Grease Pencil","Fluid Simulation of Splashes and Fire","blenderfordummies4thedition.pdf","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Fluid Simulation.md::2","sourceKey":"6 - Full Notes/Blender Fluid Simulation.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender fluid simulation blender fluid simulation","filePath":"6 - Full Notes/Blender Fluid Simulation.md","fileName":"Blender Fluid Simulation.md","folder":"6 - Full Notes","title":"Blender Fluid Simulation","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[blenderfordummies4thedition.pdf]]\n[[digitalvisualeffectsandcompositing.pdf]]","tags":["baby"],"links":["Blender Simulation and Grease Pencil","Fluid Simulation of Splashes and Fire","blenderfordummies4thedition.pdf","digitalvisualeffectsandcompositing.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}