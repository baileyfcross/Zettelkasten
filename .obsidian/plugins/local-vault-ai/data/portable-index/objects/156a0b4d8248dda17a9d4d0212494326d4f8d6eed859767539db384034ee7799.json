{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Social Explanation of AI Decisions.md::0","sourceKey":"6 - Full Notes/Social Explanation of AI Decisions.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"social explanation of ai decisions social explanation of ai decisions","filePath":"6 - Full Notes/Social Explanation of AI Decisions.md","fileName":"Social Explanation of AI Decisions.md","folder":"6 - Full Notes","title":"Social Explanation of AI Decisions","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-05 23:09\n\nStatus: #baby\n\nTags: [[AI Responsibility and Explainability]]","tags":["baby"],"links":["AI Responsibility and Explainability","Explainable AI","aiethics.epub"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Social Explanation of AI Decisions.md::1","sourceKey":"6 - Full Notes/Social Explanation of AI Decisions.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"social explanation of ai decisions social explanation of ai decisions","filePath":"6 - Full Notes/Social Explanation of AI Decisions.md","fileName":"Social Explanation of AI Decisions.md","folder":"6 - Full Notes","title":"Social Explanation of AI Decisions","heading":"Social Explanation of AI Decisions","sectionNumber":"","sectionTitle":"","content":"A social explanation of an AI decision treats explanation as an answer given by one party to another in a particular context. The affected person usually asks not for every calculation, but why this outcome occurred, what evidence mattered, how it compares with alternatives, and what can be challenged.\n\nExplanations are therefore audience-sensitive and connected to responsibility. A technical account for a developer, an audit record for a regulator, and a reason given to an applicant may all be valid at different levels. [[Explainable AI]] succeeds ethically when it supports understanding and action rather than merely increasing the volume of disclosed information.","tags":["baby"],"links":["AI Responsibility and Explainability","Explainable AI","aiethics.epub"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Social Explanation of AI Decisions.md::2","sourceKey":"6 - Full Notes/Social Explanation of AI Decisions.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"social explanation of ai decisions social explanation of ai decisions","filePath":"6 - Full Notes/Social Explanation of AI Decisions.md","fileName":"Social Explanation of AI Decisions.md","folder":"6 - Full Notes","title":"Social Explanation of AI Decisions","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[aiethics.epub]]","tags":["baby"],"links":["AI Responsibility and Explainability","Explainable AI","aiethics.epub"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}