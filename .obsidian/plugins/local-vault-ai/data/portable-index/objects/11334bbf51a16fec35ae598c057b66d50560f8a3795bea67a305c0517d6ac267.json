{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Blender Editor Draw Pipeline.md::0","sourceKey":"6 - Full Notes/Blender Editor Draw Pipeline.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender editor draw pipeline blender editor draw pipeline","filePath":"6 - Full Notes/Blender Editor Draw Pipeline.md","fileName":"Blender Editor Draw Pipeline.md","folder":"6 - Full Notes","title":"Blender Editor Draw Pipeline","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-14 00:20\n\nStatus: #baby\n\nTags: [[Blender Editor Construction]]","tags":["baby"],"links":["Blender Editor Construction","Blender Main Event Loop","Blender Window Structure","Blender Screen Area Structure","Blender Region Structure","Blender Offscreen Editor Rendering","Blender Region Draw Dispatch","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Editor Draw Pipeline.md::1","sourceKey":"6 - Full Notes/Blender Editor Draw Pipeline.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender editor draw pipeline blender editor draw pipeline","filePath":"6 - Full Notes/Blender Editor Draw Pipeline.md","fileName":"Blender Editor Draw Pipeline.md","folder":"6 - Full Notes","title":"Blender Editor Draw Pipeline","heading":"Blender Editor Draw Pipeline","sectionNumber":"","sectionTitle":"","content":"Editor drawing is the final stage of the [[Blender Main Event Loop]], after events, handlers, and notifiers have updated application data. The window manager iterates every [[Blender Window Structure]], establishes it in context, renders its screen, and then presents the completed buffer.\n\nWithin each window, the pipeline descends through [[Blender Screen Area Structure]] and [[Blender Region Structure]] records. [[Blender Offscreen Editor Rendering]] prepares only visible regions marked for redraw, and [[Blender Region Draw Dispatch]] invokes the callback registered for each region type.","tags":["baby"],"links":["Blender Editor Construction","Blender Main Event Loop","Blender Window Structure","Blender Screen Area Structure","Blender Region Structure","Blender Offscreen Editor Rendering","Blender Region Draw Dispatch","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Editor Draw Pipeline.md::2","sourceKey":"6 - Full Notes/Blender Editor Draw Pipeline.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender editor draw pipeline blender editor draw pipeline","filePath":"6 - Full Notes/Blender Editor Draw Pipeline.md","fileName":"Blender Editor Draw Pipeline.md","folder":"6 - Full Notes","title":"Blender Editor Draw Pipeline","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[coreblenderdevelopment.pdf]]","tags":["baby"],"links":["Blender Editor Construction","Blender Main Event Loop","Blender Window Structure","Blender Screen Area Structure","Blender Region Structure","Blender Offscreen Editor Rendering","Blender Region Draw Dispatch","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}