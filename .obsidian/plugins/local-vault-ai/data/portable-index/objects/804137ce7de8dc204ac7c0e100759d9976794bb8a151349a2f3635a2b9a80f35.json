{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Blender Blend File Version Conversion.md::0","sourceKey":"6 - Full Notes/Blender Blend File Version Conversion.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender blend file version conversion blender blend file version conversion","filePath":"6 - Full Notes/Blender Blend File Version Conversion.md","fileName":"Blender Blend File Version Conversion.md","folder":"6 - Full Notes","title":"Blender Blend File Version Conversion","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-14 00:20\n\nStatus: #baby\n\nTags: [[Blender DNA and File Loading]]","tags":["baby"],"links":["Blender DNA and File Loading","Blender SDNA Metadata","Blender DNA1 Block","Blender DNA Rename Map","Blender LibBlock Linking","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Blend File Version Conversion.md::1","sourceKey":"6 - Full Notes/Blender Blend File Version Conversion.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender blend file version conversion blender blend file version conversion","filePath":"6 - Full Notes/Blender Blend File Version Conversion.md","fileName":"Blender Blend File Version Conversion.md","folder":"6 - Full Notes","title":"Blender Blend File Version Conversion","heading":"Blender Blend File Version Conversion","sectionNumber":"","sectionTitle":"","content":"Blender supports reading state written by earlier releases by comparing the file's structural description with that of the running version. Initial decoding accounts for pointer size and byte order, while later structure reads transform serialized fields into current DNA layouts.\n\nThe process draws on [[Blender SDNA Metadata]] from the file's [[Blender DNA1 Block]] and on aliases from the [[Blender DNA Rename Map]]. Converting before linking lets [[Blender LibBlock Linking]] work with current structures instead of scattering historical format cases throughout the application.","tags":["baby"],"links":["Blender DNA and File Loading","Blender SDNA Metadata","Blender DNA1 Block","Blender DNA Rename Map","Blender LibBlock Linking","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Blend File Version Conversion.md::2","sourceKey":"6 - Full Notes/Blender Blend File Version Conversion.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender blend file version conversion blender blend file version conversion","filePath":"6 - Full Notes/Blender Blend File Version Conversion.md","fileName":"Blender Blend File Version Conversion.md","folder":"6 - Full Notes","title":"Blender Blend File Version Conversion","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[coreblenderdevelopment.pdf]]","tags":["baby"],"links":["Blender DNA and File Loading","Blender SDNA Metadata","Blender DNA1 Block","Blender DNA Rename Map","Blender LibBlock Linking","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}