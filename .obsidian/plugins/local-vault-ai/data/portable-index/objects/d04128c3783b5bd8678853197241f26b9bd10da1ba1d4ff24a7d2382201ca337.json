{"format":"local-vault-ai-portable-chunks-v1","version":1,"chunks":[{"id":"6 - Full Notes/Blender Custom Editor RNA Integration.md::0","sourceKey":"6 - Full Notes/Blender Custom Editor RNA Integration.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender custom editor rna integration blender custom editor rna integration","filePath":"6 - Full Notes/Blender Custom Editor RNA Integration.md","fileName":"Blender Custom Editor RNA Integration.md","folder":"6 - Full Notes","title":"Blender Custom Editor RNA Integration","heading":"Document","sectionNumber":"","sectionTitle":"","content":"2026-09-14 00:20\n\nStatus: #baby\n\nTags: [[Blender Editor Construction]]","tags":["baby"],"links":["Blender Editor Construction","Blender RNA System","Blender Custom SpaceLink Type","Blender Custom Editor Build Integration","Blender RNA Runtime and Generator Phases","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Custom Editor RNA Integration.md::1","sourceKey":"6 - Full Notes/Blender Custom Editor RNA Integration.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender custom editor rna integration blender custom editor rna integration","filePath":"6 - Full Notes/Blender Custom Editor RNA Integration.md","fileName":"Blender Custom Editor RNA Integration.md","folder":"6 - Full Notes","title":"Blender Custom Editor RNA Integration","heading":"Blender Custom Editor RNA Integration","sectionNumber":"","sectionTitle":"","content":"A new core editor must be represented in RNA if scripts and RNA-backed interface code are expected to recognize it. This requires adding the editor type to the relevant RNA space definitions and access declarations so the generated [[Blender RNA System]] can describe the new [[Blender Custom SpaceLink Type]].\n\nWithout those updates, the compiled editor may exist but scripted UI lookups cannot find its type. The requirement ties [[Blender Custom Editor Build Integration]] to the [[Blender RNA Runtime and Generator Phases]] instead of treating editor source as a self-contained addition.","tags":["baby"],"links":["Blender Editor Construction","Blender RNA System","Blender Custom SpaceLink Type","Blender Custom Editor Build Integration","Blender RNA Runtime and Generator Phases","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""},{"id":"6 - Full Notes/Blender Custom Editor RNA Integration.md::2","sourceKey":"6 - Full Notes/Blender Custom Editor RNA Integration.md","sourceType":"markdown","sectionKey":"__none__","sourceSearchName":"blender custom editor rna integration blender custom editor rna integration","filePath":"6 - Full Notes/Blender Custom Editor RNA Integration.md","fileName":"Blender Custom Editor RNA Integration.md","folder":"6 - Full Notes","title":"Blender Custom Editor RNA Integration","heading":"References","sectionNumber":"","sectionTitle":"","content":"[[coreblenderdevelopment.pdf]]","tags":["baby"],"links":["Blender Editor Construction","Blender RNA System","Blender Custom SpaceLink Type","Blender Custom Editor Build Integration","Blender RNA Runtime and Generator Phases","coreblenderdevelopment.pdf"],"properties":[],"pageStart":0,"pageEnd":0,"embeddingF32":""}]}